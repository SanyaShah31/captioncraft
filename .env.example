# =====================================================================
# CaptionCraft AI — Multimodal Caption Generator Environment Config
# =====================================================================

# Google Gemini API Key
# Get your free key at Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Default Gemini Model Name (e.g., gemini-3.8-flash, gemini-flash-latest)
# GEMINI_MODEL=gemini-3.8-flash

# =====================================================================
# MongoDB Authentication Configuration
# =====================================================================
# Connection URI (defaults to mongodb://localhost:27017 if unset)
MONGODB_URI=mongodb://localhost:27017

# Database Name (defaults to captioncraft_db if unset)
MONGODB_DATABASE=captioncraft_db

# =====================================================================
# Cloudinary Image Storage Configuration
# =====================================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# =====================================================================
# Gmail SMTP Password Reset Email Configuration
# =====================================================================
EMAIL_USER=your_gmail_address
EMAIL_PASS=your_gmail_app_password
APP_BASE_URL=http://localhost:8501

# Optional: Enable local development testing for password reset without SMTP (defaults to false)
# AUTH_DEV_MODE=false
